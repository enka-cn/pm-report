{
  "name": "manager",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "migrate": "node server/src/db/migrate.ts",
    "test": "node --test \"server/tests/**/*.test.ts\"",
    "typecheck": "tsc -p shared && tsc -p server && pnpm --filter @manager/web typecheck",
    "start": "node server/src/index.ts",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm --filter @manager/web build"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.9.2"
  }
}
